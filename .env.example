# =======================================================================
# Acadexa - Environment Configuration Example
# Copy this file to `.env` and fill in the values for your environment.
#   cp .env.example .env
# =======================================================================

# --- Database ----------------------------------------------------------
# SQLite (default, zero setup)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- App ---------------------------------------------------------------
APP_URL="http://localhost:3000"
# IMPORTANT: generate a strong random secret in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_NAME="Acadexa"

# --- Email (SMTP) ------------------------------------------------------
# Leave host empty to run in DEV mode (emails are logged to console instead of sent)
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Acadexa <no-reply@acadexa.local>"
EMAIL_FROM_ADDRESS="no-reply@acadexa.local"

# --- Storage -----------------------------------------------------------
# LOCAL stores uploaded paper files on disk under STORAGE_PATH (not publicly served)
STORAGE_PROVIDER="LOCAL"
STORAGE_PATH="./uploads"

# --- Payment -----------------------------------------------------------
# MOCK is the development provider (payment is simulated, no real money moves).
# Real providers (e.g. STRIPE, JAZZCASH, EASYPaisa) can be implemented behind
# src/lib/payment.ts and selected here.
PAYMENT_PROVIDER="MOCK"
PAYMENT_CURRENCY="PKR"

# --- WhatsApp ----------------------------------------------------------
# Default WhatsApp number used on contact/demo call buttons
WHATSAPP_NUMBER=""

# --- Admin -------------------------------------------------------------
# There is no public admin registration. Create the first admin via:
#   npm run create-admin -- --name "Admin" --email admin@example.com --password Secret123!
ADMIN_EMAIL=""
ADMIN_PASSWORD=""