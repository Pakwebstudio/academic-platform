generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum Role {
  STUDENT
  TEACHER
  RESEARCHER
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  USER_MANAGER
  CONTENT_MODERATOR
  PAYMENT_MANAGER
  VERIFICATION_MANAGER
  SUPPORT_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  PENDING_VERIFICATION
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum PaperStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  REQUEST_CHANGES
  REMOVED
  SUSPENDED
}

enum AccessType {
  FREE
  PAID
  EXTERNAL_LINK
}

enum PermissionStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
  EXPIRED
  REQUEST_CHANGES
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  CANCELLED
}

enum CallRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum CollaborationStatus {
  OPEN
  CLOSED
  FILLED
}

enum CollaborationRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ReportCategory {
  COPYRIGHT
  INCORRECT_INFO
  SPAM
  HARASSMENT
  FRAUD
  INAPPROPRIATE_CONTENT
  OTHER
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

// ============ M2M JOIN TABLES ============

model UniversityDepartment {
  universityId String
  departmentId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  @@id([universityId, departmentId])
}

model PaperResearchArea {
  paperId        String
  researchAreaId String
  paper          ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  researchArea   ResearchArea  @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)
  @@id([paperId, researchAreaId])
}

model UserResearchInterest {
  userId         String
  researchAreaId String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchArea   ResearchArea  @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)
  @@id([userId, researchAreaId])
}

// ============ CORE ============

model User {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  emailVerified      DateTime?
  passwordHash       String
  role               Role          @default(STUDENT)
  adminRole          AdminRole?
  status             UserStatus    @default(PENDING_VERIFICATION)
  verificationStatus VerificationStatus @default(NONE)
  avatarUrl          String?
  bio                String?
  location           String?
  phone              String?
  title              String?
  designation        String?
  departmentId       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  lastActiveAt       DateTime?

  isDemo             Boolean       @default(false)
  isSeed             Boolean       @default(false)

  department         Department?   @relation(fields: [departmentId], references: [id])
  researchInterests  UserResearchInterest[]
  profile            Profile?
  researcherProfile  ResearcherProfile?
  papers             ResearchPaper[]      @relation("PaperUploader")
  paperAuthors       PaperAuthor[]
  permissionRequests PaperPermissionRequest[] @relation("PermissionRequester")
  purchases          PaperPurchase[]
  paperAccesses      PaperAccess[]
  notifications      Notification[]
  conversations      ConversationMember[]
  sentMessages       Message[]            @relation("MessageSender")
  callRequestsMade   CallRequest[]        @relation("CallRequester")
  callRequestsReceived CallRequest[]      @relation("CallResearcher")
  collaborations     ResearchCollaboration[]
  collaborationRequests CollaborationRequest[] @relation("CollaborationRequester")
  reportsMade        Report[]             @relation("Reporter")
  verificationRequest VerificationRequest?
  qualifications     AcademicQualification[]
  experiences        Experience[]
  socialLinks        SocialLink[]
  auditLogs          AuditLog[]           @relation("AuditActor")
  userReports        Report[]             @relation("ReportedUser")
  adminInvited       AdminInvitation[]    @relation("InvitedBy")
  notificationsSent  AdminNotification[]  @relation("NotificationSender")
  payments           Payment[]
  earnings           Earning[]
  uploadedFiles      FileAsset[]

  @@index([role])
  @@index([status])
  @@index([email])
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  phone      String?
  website    String?
  country    String?
  city       String?
  address    String?
  headline   String?
  bio        String?
  skills     String?
  profileCompletion Int @default(0)
  views      Int      @default(0)
  aboutUs    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResearcherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  universityId   String?
  departmentId   String?
  designation    String?
  experienceYears Int?
  bio            String?
  researchFocus  String?
  citations      Int      @default(0)
  publications   Int      @default(0)
  verified       Boolean  @default(false)
  whatsappNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University?  @relation(fields: [universityId], references: [id])
  department Department?  @relation(fields: [departmentId], references: [id])

  @@index([universityId])
}

model AcademicQualification {
  id          String   @id @default(cuid())
  userId      String
  degree      String
  university  String
  field       String?
  yearFrom    Int?
  yearTo      Int?
  description String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Experience {
  id           String   @id @default(cuid())
  userId       String
  role         String
  organization String
  location     String?
  startYear    Int?
  endYear      Int?
  current      Boolean  @default(false)
  description  String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model SocialLink {
  id        String @id @default(cuid())
  userId    String
  platform  String
  url       String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// ============ ORGANIZATION ============

model University {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  description   String?
  website       String?
  country       String?
  city          String?
  address       String?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isSeed        Boolean  @default(false)

  departments    UniversityDepartment[]
  researchers    ResearcherProfile[]
  papers         ResearchPaper[]
  adminNotifications AdminNotification[]

  @@index([name])
}

model Department {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universities UniversityDepartment[]
  members      User[]
  researcherProfiles ResearcherProfile[]

  @@index([name])
}

model ResearchArea {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  icon         String?
  color        String?
  createdAt    DateTime @default(now())
  isSeed       Boolean  @default(false)

  papers       PaperResearchArea[]
  users        UserResearchInterest[]

  @@index([name])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  papers      ResearchPaper[]
}

// ============ RESEARCH PAPER ============

model ResearchPaper {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  abstract        String
  keywords        String?
  researchField   String?
  publicationType String?
  journal         String?
  conference      String?
  publisher       String?
  publicationDate DateTime?
  doi             String?
  volume          String?
  issue           String?
  pages           String?
  citations       Int         @default(0)
  externalUrl     String?
  pdfUrl          String?
  coverImageUrl   String?
  fileAssetId     String?     @unique
  price           Float?
  currency        String      @default("PKR")
  accessType      AccessType  @default(FREE)
  status          PaperStatus @default(PENDING_REVIEW)
  views           Int         @default(0)
  rejectionReason String?
  licenseType     String?
  needsPermission Boolean     @default(false)
  isAuthorized    Boolean     @default(false)
  categoryId      String?
  uploaderId      String
  universityId    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  uploader        User        @relation("PaperUploader", fields: [uploaderId], references: [id])
  category        Category?   @relation(fields: [categoryId], references: [id])
  university      University? @relation(fields: [universityId], references: [id])
  authors         PaperAuthor[]
  researchAreas   PaperResearchArea[]
  permissions     PaperPermissionRequest[]
  purchases       PaperPurchase[]
  fileAsset       FileAsset?  @relation(fields: [fileAssetId], references: [id])
  reports         Report[]    @relation("ReportedPaper")
  accessRecords   PaperAccess[]
  earnings        Earning[]

  @@index([status])
  @@index([accessType])
  @@index([uploaderId])
  @@index([title])
  @@index([createdAt])
}

model PaperAuthor {
  id           String   @id @default(cuid())
  paperId      String
  userId       String?
  name         String
  email        String?
  affiliation  String?
  isPrimary    Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  paper        ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([paperId])
  @@index([userId])
}

model PaperPermissionRequest {
  id              String           @id @default(cuid())
  requesterId     String
  paperId         String
  authorUserId    String?
  authorName      String
  reason          String
  proposedPrice   Float?
  revenueSplit    Float?
  requestedPermission String
  status          PermissionStatus @default(PENDING)
  responseMessage String?
  expiresAt       DateTime?
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  requester       User             @relation("PermissionRequester", fields: [requesterId], references: [id])
  paper           ResearchPaper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([authorUserId])
  @@index([status])
}

model PaperAccess {
  id          String   @id @default(cuid())
  purchaseId  String?
  userId      String
  paperId     String
  accessToken String   @unique
  grantedAt   DateTime @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?

  purchase   PaperPurchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper      ResearchPaper  @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paperId])
}

// ============ PURCHASE & PAYMENT ============

model PaperPurchase {
  id           String        @id @default(cuid())
  buyerId      String
  paperId      String
  amount       Float
  currency     String        @default("PKR")
  platformFee  Float
  sellerAmount Float
  status       PaymentStatus @default(PENDING)
  accessStatus String        @default("GRANTED")

  buyer        User          @relation(fields: [buyerId], references: [id])
  paper        ResearchPaper @relation(fields: [paperId], references: [id])
  payment      Payment?
  accessRecords PaperAccess[]
  refunds      Refund[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([buyerId])
  @@index([paperId])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  purchaseId        String        @unique
  userId            String
  amount            Float
  currency          String        @default("PKR")
  provider          String        @default("MOCK")
  providerTransactionId String?
  status            PaymentStatus @default(PENDING)
  platformFee       Float         @default(0)
  sellerAmount      Float         @default(0)
  paymentMethod     String?
  rawPayload        String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  purchase          PaperPurchase @relation(fields: [purchaseId], references: [id])
  user              User          @relation(fields: [userId], references: [id])
  refunds           Refund[]
  earnings          Earning[]

  @@index([userId])
  @@index([status])
}

model Earning {
  id           String       @id @default(cuid())
  userId       String
  paymentId    String
  paperId      String
  purchaseId   String
  grossAmount  Float
  platformFee  Float
  sellerAmount Float
  status       String       @default("PENDING")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  payment      Payment      @relation(fields: [paymentId], references: [id])
  paper        ResearchPaper @relation(fields: [paperId], references: [id])

  @@index([userId])
  @@index([status])
}

model Refund {
  id          String        @id @default(cuid())
  paymentId   String
  purchaseId  String
  amount      Float
  reason      String?
  status      RefundStatus  @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  payment     Payment       @relation(fields: [paymentId], references: [id])
  purchase    PaperPurchase @relation(fields: [purchaseId], references: [id])

  @@index([paymentId])
}

// ============ COMMUNICATION ============

model CallRequest {
  id             String            @id @default(cuid())
  requesterId    String
  researcherId   String
  name           String?
  email          String?
  phone          String
  reason         String
  preferredDate  DateTime?
  preferredTime  String?
  message        String?
  status         CallRequestStatus @default(PENDING)
  rescheduledDate DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  requester      User              @relation("CallRequester", fields: [requesterId], references: [id])
  researcher     User              @relation("CallResearcher", fields: [researcherId], references: [id])

  @@index([researcherId])
  @@index([status])
}

model Conversation {
  id            String          @id @default(cuid())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lastMessageAt DateTime?

  members       ConversationMember[]
  messages      Message[]
  reports       Report[]        @relation("ReportedConversation")

  @@index([updatedAt])
}

model ConversationMember {
  id             String        @id @default(cuid())
  conversationId String
  userId         String
  unreadCount    Int           @default(0)
  blocked        Boolean       @default(false)
  joinedAt       DateTime      @default(now())

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean       @default(false)
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

// ============ COLLABORATION ============

model ResearchCollaboration {
  id             String                     @id @default(cuid())
  userId         String
  title          String
  description    String
  researchField  String?
  requiredSkills String?
  location       String?
  remote         Boolean                    @default(false)
  deadline       DateTime?
  status         CollaborationStatus        @default(OPEN)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  user           User                       @relation(fields: [userId], references: [id])
  requests       CollaborationRequest[]
  reports        Report[]                   @relation("ReportedCollaboration")

  @@index([userId])
  @@index([status])
}

model CollaborationRequest {
  id              String                      @id @default(cuid())
  collaborationId String
  requesterId     String
  message         String?
  status          CollaborationRequestStatus  @default(PENDING)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  collaboration   ResearchCollaboration       @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  requester       User                        @relation("CollaborationRequester", fields: [requesterId], references: [id])

  @@index([collaborationId])
  @@index([requesterId])
}

// ============ REPORTING & VERIFICATION ============

model Report {
  id              String         @id @default(cuid())
  reporterId      String
  reportedUserId  String?
  paperId         String?
  conversationId  String?
  collaborationId String?
  category        ReportCategory
  description     String
  status          ReportStatus   @default(OPEN)
  assignedTo      String?
  resolutionNotes String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  reporter        User           @relation("Reporter", fields: [reporterId], references: [id])
  reportedUser    User?          @relation("ReportedUser", fields: [reportedUserId], references: [id])
  paper           ResearchPaper? @relation("ReportedPaper", fields: [paperId], references: [id])
  conversation    Conversation?  @relation("ReportedConversation", fields: [conversationId], references: [id])
  collaboration   ResearchCollaboration? @relation("ReportedCollaboration", fields: [collaborationId], references: [id])

  @@index([status])
  @@index([reportedUserId])
}

model VerificationRequest {
  id              String             @id @default(cuid())
  userId          String             @unique
  universityName  String?
  departmentName  String?
  designation     String?
  evidence        String?
  status          VerificationStatus @default(PENDING)
  adminMessage    String?
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  priority  NotificationPriority @default(LOW)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model AdminNotification {
  id           String   @id @default(cuid())
  senderId     String
  title        String
  message      String
  audience     String
  universityId String?
  priority     NotificationPriority @default(LOW)
  createdAt    DateTime @default(now())

  sender       User     @relation("NotificationSender", fields: [senderId], references: [id])
  university   University? @relation(fields: [universityId], references: [id])

  @@index([audience])
}

// ============ ADMIN ============

model AdminInvitation {
  id          String    @id @default(cuid())
  email       String
  name        String
  adminRole   AdminRole
  permissions String?
  token       String    @unique
  expiresAt   DateTime
  used        Boolean   @default(false)
  usedAt      DateTime?
  invitedById String
  createdAt   DateTime  @default(now())

  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([token])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  before     String?
  after      String?
  ip         String?
  metadata   String?
  createdAt  DateTime @default(now())

  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ============ SETTINGS ============

model PlatformSetting {
  id          String @id @default(cuid())
  key         String @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ============ FILES ============

model FileAsset {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String
  size         Int
  storagePath  String
  publicUrl    String?
  provider     String   @default("LOCAL")
  uploadedById String?
  createdAt    DateTime @default(now())

  paper        ResearchPaper?
  uploader     User?    @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById])
}
